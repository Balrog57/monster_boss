[gd_scene load_steps=2 format=3 uid="uid://bossmonster_board_scene"]

[ext_resource type="Script" path="res://godot/scripts/BoardUI.gd" id="1_script"]

[node name="Board" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.04, 0.04, 0.06, 1)

[node name="TopBar" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 20.0
offset_top = 15.0
offset_right = -20.0
offset_bottom = 55.0
grow_horizontal = 2
theme_override_constants/separation = 20

[node name="BtnMenu" type="Button" parent="TopBar"]
custom_minimum_size = Vector2(100, 36)
layout_mode = 2
text = "Menu"

[node name="StatusLabel" type="Label" parent="TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Tour 1 — Phase SETUP"
vertical_alignment = 1

[node name="StatsLabel" type="Label" parent="TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Âmes : 0/10 | Blessures : 0/5"
horizontal_alignment = 2
vertical_alignment = 1

[node name="DeckArea" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -280.0
offset_top = 70.0
offset_right = -20.0
offset_bottom = 270.0
grow_horizontal = 0

[node name="DeckInfoLabel" type="Label" parent="DeckArea"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.8, 1, 1)
theme_override_font_sizes/font_size = 14
text = "Pioche Salles : 0\nPioche Sorts : 0\nHéros restants : 0"

[node name="DiscardInfoLabel" type="Label" parent="DeckArea"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.6, 0.6, 1)
theme_override_font_sizes/font_size = 14
text = "Défausse Salles : 0\nDéfausse Sorts : 0\nDéfausse Héros : 0"

[node name="TownArea" type="VBoxContainer" parent="."]
layout_mode = 1
