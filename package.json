{
  "name": "monster_boss",
  "version": "2.0.0",
  "description": "Boss Monster - turn-based dungeon-building card game, custom Node + Socket.IO + PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "serve": "node server/index.js",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:unit": "node --test test/engine.test.js test/reducer.test.js test/ai.test.js test/expansions.test.js test/card-matrix.test.js test/engine-invariants.test.js test/adventure-timing.test.js",
    "card-matrix": "node tools/generate_card_matrix.js",
    "merge:expansions": "python tools/merge_expansions.py",
    "fetch:expansions": "python tools/fetch_expansion_packs.py && python tools/merge_expansions.py",
    "fetch:expansion-art": "python tools/fetch_expansion_art.py",
    "extract:music": "python tools/extract_music.py",
    "verify:assets": "node tools/verify_assets.js"
  },
  "dependencies": {
    "@koa/router": "^10.1.1",
    "koa": "^2.16.4",
    "koa-body": "^5.0.0",
    "koa-static": "^5.0.0",
    "nanoid": "^3.3.15",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balrog57/monster_boss.git"
  },
  "keywords": [
    "boardgame",
    "boss-monster",
    "multiplayer",
    "socket.io",
    "postgres"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Balrog57/monster_boss/issues"
  },
  "homepage": "https://github.com/Balrog57/monster_boss#readme"
}
