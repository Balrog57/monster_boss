# Copier vers .env (jamais commité). Voir security/SECURITY.md.
PORT=8000
NODE_ENV=production
DATABASE_URL=postgres://boss:CHANGE_ME@db:5432/bossmonster
TZ=Europe/Paris
# Optionnel :
DB_POOL_MAX=10
STALE_MATCH_MS=3600000
CLEANUP_INTERVAL_MS=1800000
MAX_MOVES_PER_SEC=10
FLUSH_INTERVAL_MS=5000
TURN_TIMEOUT_MS=60000
