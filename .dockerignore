# .dockerignore - contexte de build = racine du dépôt (deploy/docker-compose.yml
# `build.context: ..`). L'image exporte le jeu Godot elle-même (deploy/Dockerfile) :
# src/frontend (project.godot, export_presets.cfg, godot/, assets/) DOIT rester
# dans le contexte. On n'exclut que ce qui est lourd ou inutile à l'export.

# APK d'origine + décompilation (local uniquement, jamais embarqué)
apk-original
*.apk
boss-monster-2-*/

# VCS, caches Godot et sortie d'export locale (régénérée dans l'image)
.git
**/.godot
src/frontend/godot/build_web

# Docs, design, audits
docs
security

# Outillage et artefacts locaux
tools/apk-oracle/bin
tools/apk-oracle/obj
tools/apk-oracle/out
*.log
.DS_Store
