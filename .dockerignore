# .dockerignore - keep the Docker build context lean (context = repo root,
# see deploy/docker-compose.yml `build.context: ..`).
# Only package.json, src/ (dont src/frontend/godot/build_web/, exporté via
# `npm run export:web`) are needed to run the game. Everything else is
# dev/design/source material.

# Dependencies & build output (rebuilt inside the image)
node_modules
dist
.godot

# Original APK + decompiled reference (local-only, never shipped)
apk-original
boss-monster-2-2-6-android.apk
boss-monster-2-4-12.apk
boss-monster-2-2-6/
boss-monster-2-4-12/
design_system
docs
security

# Godot sources (seul l'export web est embarqué ; `assets` ci-dessous couvre
# aussi src/frontend/assets, les motifs sans slash s'appliquant à tout niveau)
src/frontend/godot/*.gd
src/frontend/godot/scenes
src/frontend/godot/scripts
src/frontend/godot/tests
src/frontend/godot/data
src/frontend/project.godot
src/frontend/export_presets.cfg

# Deploy descriptors (host-side only)
deploy

# Tests & tooling
tests
test-results
.playwright-mcp
.opencode
tools

# Assets sources (le client web embarque déjà audio/fonts ; l'art des cartes
# HD sera servi à part en phase 2)
assets

# VCS & misc
.git
.gitignore
*.log
.DS_Store
